{
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "?.lua",
    "?/init.lua"
  ],
  "workspace.library": [
    "C:/Projects/Foragers/Foragers/Tools/LuaAnalyzer/libs/love2d-luacats"
  ],
  "workspace.ignoreDir": [
    ".git",
    ".kilo"
  ],
  "diagnostics.enable": true,
  "diagnostics.globals": [
    "love",
    "utf8"
  ],
  "diagnostics.neededFileStatus": {
    "nil-type-mismatch": "Warning",
    "param-type-mismatch": "Warning",
    "undefined-global": "Warning",
    "unused-local": "Warning",
    "redefined-global": "Warning"
  }
}
